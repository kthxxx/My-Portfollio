# --- Site URL (used by metadata and robots.txt) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (optional — powers the `guestbook` command) ---
# Create a project at https://supabase.com, run the SQL in lib/supabase.ts,
# then copy your project's URL and anon key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (optional — powers the `contact` form) ---
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=

# --- Feature flags ---
# Set to "false" to disable the Three.js particle background entirely.
NEXT_PUBLIC_ENABLE_SCENE=true
